    "Semantic Web",
    "Linked Data"
  ],
  "bugs": "https://github.com/rdfjs/Yasgui/issues/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rdfjs/Yasgui.git",
    "directory": "packages/yasqe"
  },
  "dependencies": {
    "@zazuko/yasgui-utils": "^4.6.2",
